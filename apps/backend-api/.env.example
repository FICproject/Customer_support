# Server Config
PORT=4000
NODE_ENV=production

# Database & Cache
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai_customer_support?retryWrites=true&w=majority
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Models (Gemini & OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Telephony & SMS Integration (Exotel)
EXOTEL_ACCOUNT_SID=your_account_sid
EXOTEL_API_KEY=your_api_key
EXOTEL_API_TOKEN=your_api_token
EXOTEL_VIRTUAL_NUMBER=08047288293
EXOTEL_SUBDOMAIN=api.exotel.com
